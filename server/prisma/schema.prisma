generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id               String    @id @default(cuid())
  code             String    @unique
  name             String
  passwordHash     String?
  hostClientId     String
  focusMin         Int       @default(25)
  breakMin         Int       @default(5)
  longBreakMin     Int       @default(15)
  cyclesBeforeLong Int       @default(4)
  autoStart        Boolean   @default(false)
  timerControl     String    @default("host")
  // persisted timer
  timerPhase       String    @default("focus")
  timerStatus      String    @default("idle")
  timerDurationMs  Int       @default(1500000)
  timerRemainingMs Int       @default(1500000)
  timerEndsAt      BigInt?
  completedFocus   Int       @default(0)
  timerVersion     Int       @default(0)
  createdAt        DateTime  @default(now())
  lastActiveAt     DateTime  @default(now())
  messages         Message[]
  blocks           RoomBlock[]

  @@index([lastActiveAt])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  clientId  String
  nickname  String
  text      String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

// Kicked or banned members. Keyed by the public userId so no clientId is stored.
model RoomBlock {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  // Nickname at removal time, kept only so the host's block list is readable.
  nickname  String   @default("")
  reason    String
  blockedAt DateTime @default(now())
  // Set for a kick, null for a ban that lasts until the host lifts it.
  expiresAt DateTime?

  @@unique([roomId, userId])
}
